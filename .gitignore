# Ignore everything in repository by default
*

# Allow essential source code, tests, documentation, and configuration
!/.gitignore
!/README.md
!/DOCUMENTATION.md
!/zkai/
!/zkai/**
!/tests/
!/tests/**

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
env/
*.zk
*.safetensors
*.bin
*.log
